# Neon (or any Postgres with the PostGIS extension available).
# Use the pooled connection string; keep sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/crisislink?sslmode=require"

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Shared secret for the scheduled feed pollers. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Leave blank in local dev to call the
# cron routes from a browser.
CRON_SECRET=""

# --- Text classification (optional) ---------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Leave BLANK to disable classification entirely — the confidence formula
# drops the component and renormalises, and the pipeline stays correct.
#
# PRIVACY: Google's FREE-tier terms say submitted content is used to improve
# their products, that human reviewers may read API input and output, and
# "Do not submit sensitive, confidential, or personal information to the
# Unpaid Services." Citizen report text can contain personal information.
# Acceptable for a scoped prototype if disclosed; not for real deployment.
GEMINI_API_KEY=""

# Optional model override. Check which models your key can reach on the free
# tier at https://aistudio.google.com/rate-limit
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Web Push (VAPID) -------------------------------------------------------
# Generate a keypair locally — no account or service required:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is exposed to the browser (that is what NEXT_PUBLIC_ means);
# the private key signs push requests and must stay server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address push services can reach you at, per the VAPID spec.
VAPID_SUBJECT="mailto:you@example.com"

# --- Android TWA (optional) -------------------------------------------------
# Only needed once you build the Trusted Web Activity with Bubblewrap.
# Get the fingerprint from the keystore Bubblewrap creates:
#   keytool -list -v -keystore android.keystore -alias android
# Comma-separate if you also add Play App Signing's fingerprint.
TWA_SHA256_FINGERPRINT=""
TWA_PACKAGE_NAME="app.crisislink.twa"
